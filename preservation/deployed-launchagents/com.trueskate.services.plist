<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.trueskate.services</string>
<key>ProgramArguments</key>
<array>
  <string>/Users/training-server/trueskate-ai/.venv/bin/python</string>
  <string>scripts/launch_services.py</string>
  <string>--devices</string>
  <string>iPhone_XR,iPhone_XR2</string>
</array>
<key>WorkingDirectory</key><string>/Users/training-server/trueskate-ai</string>
<key>EnvironmentVariables</key>
<dict><key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>StandardOutPath</key><string>/Users/training-server/trueskate-ai/logs/services_agent.log</string>
<key>StandardErrorPath</key><string>/Users/training-server/trueskate-ai/logs/services_agent.log</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>60</integer>
</dict></plist>

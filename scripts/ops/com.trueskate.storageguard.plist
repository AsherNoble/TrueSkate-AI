<?xml version="1.0" encoding="UTF-8"?>
<!--
  Storage guard: stops SLS collection + ntfy-alerts when the rig's local SSD (or the
  Modal volume) runs low. Prevents the disk-full wedge that broke the rig once.

  Install (as training-server, on the RIG):
    cp /Users/training-server/trueskate-ai/scripts/ops/com.trueskate.storageguard.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.trueskate.storageguard.plist
    launchctl enable gui/$(id -u)/com.trueskate.storageguard
  Check:  tail -f /Users/training-server/trueskate-ai/logs/storage_guard.log
  Stop:   launchctl bootout gui/$(id -u)/com.trueskate.storageguard

  Runs every 5 min. Tune thresholds via EnvironmentVariables below.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trueskate.storageguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/training-server/trueskate-ai/scripts/ops/storage_guard.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LOCAL_MIN_GB</key>
        <string>25</string>
        <key>MODAL_MAX_GB</key>
        <string>950</string>
        <key>MODAL_VOLUME</key>
        <string>trueskate-corpus</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/training-server/trueskate-ai/logs/storage_guard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/training-server/trueskate-ai/logs/storage_guard.out.log</string>
</dict>
</plist>

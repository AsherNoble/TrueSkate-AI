<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.trueskate.appium.xr1</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/node</string><string>/usr/local/bin/appium</string>
    <string>--port</string><string>4723</string>
    <string>--address</string><string>127.0.0.1</string>
    <string>--allow-insecure</string><string>xcuitest:xctest_screen_record,*:session_discovery</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/training-server/trueskate-ai-runtime/logs/appium-xr1.log</string>
  <key>StandardErrorPath</key><string>/Users/training-server/trueskate-ai-runtime/logs/appium-xr1.log</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
</dict></plist>
